"""
Library Management System
--------------------------
A console-based application using Python + MySQL.

Features:
1. Add / View / Search / Delete Books
2. Add / View Members
3. Issue a Book to a Member
4. Return a Book (with fine calculation)
5. View all issued books

Requirements:
    pip install mysql-connector-python

Setup:
    1. Run schema.sql in your MySQL server first
       (e.g. mysql -u root -p < schema.sql)
    2. Update DB_CONFIG below with your MySQL credentials
    3. Run: python library_management.py
"""

import mysql.connector
from mysql.connector import Error
from datetime import date, timedelta

# ---------------------------------------------------
# Database configuration - EDIT THESE VALUES
# ---------------------------------------------------
DB_CONFIG = {
    "host": "localhost",
    "user": "root",
    "password": "your_password_here",
    "database": "library_db"
}

LOAN_PERIOD_DAYS = 14      # default borrowing period
FINE_PER_DAY = 5.00        # fine in rupees per day overdue


def get_connection():
    """Create and return a new MySQL connection."""
    try:
        conn = mysql.connector.connect(**DB_CONFIG)
        return conn
    except Error as e:
        print(f"[ERROR] Could not connect to database: {e}")
        return None


# ---------------------------------------------------
# BOOK OPERATIONS
# ---------------------------------------------------
def add_book():
    title = input("Title: ").strip()
    author = input("Author: ").strip()
    genre = input("Genre: ").strip()
    copies = int(input("Number of copies: ").strip())

    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO books (title, author, genre, total_copies, available_copies) "
        "VALUES (%s, %s, %s, %s, %s)",
        (title, author, genre, copies, copies)
    )
    conn.commit()
    print(f"[OK] Book '{title}' added with {copies} copies.")
    cur.close()
    conn.close()


def view_books():
    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    cur.execute("SELECT book_id, title, author, genre, available_copies, total_copies FROM books")
    rows = cur.fetchall()
    if not rows:
        print("No books found.")
    else:
        print(f"\n{'ID':<5}{'Title':<30}{'Author':<20}{'Genre':<15}{'Avail/Total':<10}")
        print("-" * 80)
        for r in rows:
            print(f"{r[0]:<5}{r[1]:<30}{r[2]:<20}{r[3] or '-':<15}{str(r[4])+'/'+str(r[5]):<10}")
    cur.close()
    conn.close()


def search_book():
    keyword = input("Enter title/author keyword: ").strip()
    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    cur.execute(
        "SELECT book_id, title, author, available_copies FROM books "
        "WHERE title LIKE %s OR author LIKE %s",
        (f"%{keyword}%", f"%{keyword}%")
    )
    rows = cur.fetchall()
    if not rows:
        print("No matching books found.")
    else:
        for r in rows:
            print(f"[{r[0]}] {r[1]} by {r[2]} - Available: {r[3]}")
    cur.close()
    conn.close()


def delete_book():
    book_id = input("Enter Book ID to delete: ").strip()
    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    cur.execute("DELETE FROM books WHERE book_id = %s", (book_id,))
    conn.commit()
    if cur.rowcount:
        print("[OK] Book deleted.")
    else:
        print("[ERROR] No book found with that ID.")
    cur.close()
    conn.close()


# ---------------------------------------------------
# MEMBER OPERATIONS
# ---------------------------------------------------
def add_member():
    name = input("Member name: ").strip()
    email = input("Email: ").strip()
    phone = input("Phone: ").strip()

    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    try:
        cur.execute(
            "INSERT INTO members (name, email, phone) VALUES (%s, %s, %s)",
            (name, email, phone)
        )
        conn.commit()
        print(f"[OK] Member '{name}' added with ID {cur.lastrowid}.")
    except Error as e:
        print(f"[ERROR] Could not add member: {e}")
    cur.close()
    conn.close()


def view_members():
    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    cur.execute("SELECT member_id, name, email, phone FROM members")
    rows = cur.fetchall()
    if not rows:
        print("No members found.")
    else:
        print(f"\n{'ID':<5}{'Name':<20}{'Email':<30}{'Phone':<15}")
        print("-" * 70)
        for r in rows:
            print(f"{r[0]:<5}{r[1]:<20}{r[2]:<30}{r[3] or '-':<15}")
    cur.close()
    conn.close()


# ---------------------------------------------------
# ISSUE / RETURN OPERATIONS
# ---------------------------------------------------
def issue_book():
    book_id = input("Book ID to issue: ").strip()
    member_id = input("Member ID: ").strip()

    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()

    cur.execute("SELECT available_copies FROM books WHERE book_id = %s", (book_id,))
    row = cur.fetchone()
    if not row:
        print("[ERROR] Book not found.")
        cur.close(); conn.close(); return
    if row[0] <= 0:
        print("[ERROR] No copies available right now.")
        cur.close(); conn.close(); return

    issue_date = date.today()
    due_date = issue_date + timedelta(days=LOAN_PERIOD_DAYS)

    cur.execute(
        "INSERT INTO transactions (book_id, member_id, issue_date, due_date, status) "
        "VALUES (%s, %s, %s, %s, 'ISSUED')",
        (book_id, member_id, issue_date, due_date)
    )
    cur.execute(
        "UPDATE books SET available_copies = available_copies - 1 WHERE book_id = %s",
        (book_id,)
    )
    conn.commit()
    print(f"[OK] Book issued. Due date: {due_date}")
    cur.close()
    conn.close()


def return_book():
    txn_id = input("Transaction ID (see 'View Issued Books'): ").strip()

    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()

    cur.execute(
        "SELECT book_id, due_date, status FROM transactions WHERE txn_id = %s",
        (txn_id,)
    )
    row = cur.fetchone()
    if not row:
        print("[ERROR] Transaction not found.")
        cur.close(); conn.close(); return
    if row[2] == "RETURNED":
        print("[ERROR] This book was already returned.")
        cur.close(); conn.close(); return

    book_id, due_date, _ = row
    return_date = date.today()
    overdue_days = (return_date - due_date).days
    fine = round(overdue_days * FINE_PER_DAY, 2) if overdue_days > 0 else 0.00

    cur.execute(
        "UPDATE transactions SET return_date = %s, fine_amount = %s, status = 'RETURNED' "
        "WHERE txn_id = %s",
        (return_date, fine, txn_id)
    )
    cur.execute(
        "UPDATE books SET available_copies = available_copies + 1 WHERE book_id = %s",
        (book_id,)
    )
    conn.commit()

    if fine > 0:
        print(f"[OK] Book returned. Overdue by {overdue_days} day(s). Fine: Rs.{fine}")
    else:
        print("[OK] Book returned on time. No fine.")
    cur.close()
    conn.close()


def view_issued_books():
    conn = get_connection()
    if not conn:
        return
    cur = conn.cursor()
    cur.execute("""
        SELECT t.txn_id, b.title, m.name, t.issue_date, t.due_date, t.status
        FROM transactions t
        JOIN books b ON t.book_id = b.book_id
        JOIN members m ON t.member_id = m.member_id
        WHERE t.status = 'ISSUED'
        ORDER BY t.due_date
    """)
    rows = cur.fetchall()
    if not rows:
        print("No books currently issued.")
    else:
        print(f"\n{'TxnID':<7}{'Book':<25}{'Member':<20}{'Issued':<12}{'Due':<12}")
        print("-" * 80)
        for r in rows:
            print(f"{r[0]:<7}{r[1]:<25}{r[2]:<20}{str(r[3]):<12}{str(r[4]):<12}")
    cur.close()
    conn.close()


# ---------------------------------------------------
# MAIN MENU
# ---------------------------------------------------
def main_menu():
    menu = """
========== LIBRARY MANAGEMENT SYSTEM ==========
1.  Add Book
2.  View All Books
3.  Search Book
4.  Delete Book
5.  Add Member
6.  View Members
7.  Issue Book
8.  Return Book
9.  View Issued Books
0.  Exit
================================================
"""
    actions = {
        "1": add_book,
        "2": view_books,
        "3": search_book,
        "4": delete_book,
        "5": add_member,
        "6": view_members,
        "7": issue_book,
        "8": return_book,
        "9": view_issued_books,
    }

    while True:
        print(menu)
        choice = input("Enter your choice: ").strip()
        if choice == "0":
            print("Goodbye!")
            break
        action = actions.get(choice)
        if action:
            try:
                action()
            except Exception as e:
                print(f"[ERROR] Something went wrong: {e}")
        else:
            print("Invalid choice, try again.")


if __name__ == "__main__":
    main_menu()
